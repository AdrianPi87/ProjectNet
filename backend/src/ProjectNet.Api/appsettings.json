{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ProjectNet;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Messaging": { "UseRabbitMq": false },
  "Jwt": {
    "Issuer": "ProjectNet.Api",
    "Audience": "ProjectNet.Frontend",
    "Key": "development-key-change-in-production-123456789!",
    "ExpiresMinutes": 120
  }
}
